{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "types": ["@citizenfx/client"],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["client"]
}
